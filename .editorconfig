# EditorConfig: https://editorconfig.org
# 统一本仓库所有编辑器的代码风格

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Kotlin / Kotlin DSL (Gradle)
[*.{kt,kts}]
indent_style = space
indent_size = 4

# XML / 资源
[*.xml]
indent_style = space
indent_size = 4

# JSON / TOML
[*.{json,toml}]
indent_style = space
indent_size = 2

# Markdown：保留行尾两空格（硬换行），不裁剪
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefile 必须用 Tab
[Makefile]
indent_style = tab
